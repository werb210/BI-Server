# BI-Server environment. Every variable read by live code under src/ is listed here
# (BI_SERVER_BLOCK_v789). Values are safe local defaults or blank; never commit real secrets.

# --- Core --------------------------------------------------------------------------------
# development | test | production (production disables dev-only fallbacks such as the PGI stub default).
NODE_ENV=development
# HTTP port the server listens on (Azure sets this).
PORT=8080
# Postgres connection string for the BI database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bi_server
# Secret that signs and verifies staff, lender, applicant and referrer JWTs.
JWT_SECRET=dev-jwt-secret
# Legacy fallback for JWT_SECRET, read only by the lender API token check when JWT_SECRET is unset.
BI_JWT_SECRET=
# When set, service tokens exchanged with BF-Server are signed/verified with it and JWT_SECRET-signed service tokens are rejected.
BI_SERVICE_JWT_SECRET=
# /metrics requires Authorization: Bearer <METRICS_TOKEN>; unset -> /metrics returns 404.
METRICS_TOKEN=
# pino log level (trace, debug, info, warn, error).
LOG_LEVEL=info
# Build label shown by /health and the build routes (the deploy workflow stamps it; else BUILD_META, else "unknown").
BUILD_TAG=
# Commit SHA shown by /health and the build routes (the deploy workflow stamps it).
COMMIT_SHA=
# Set to false (e.g. on the staging slot) to start no background workers or scheduled jobs.
BI_WORKERS_ENABLED=true
# Set to true to schedule the daily premium accrual job (off by default).
ENABLE_PREMIUM_ACCRUAL=false
# Days a document stays in the purge queue before the purge job deletes it.
PURGE_BUFFER_DAYS=30
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Staff admin sign-in -----------------------------------------------------------------
# Email of the single env-configured admin login (both ADMIN_* must be set to enable it).
ADMIN_EMAIL=
# bcrypt hash of that admin's password.
ADMIN_PASSWORD_HASH=

# --- OTP / sign-in -----------------------------------------------------------------------
# true lets code 000000 pass OTP checks when Twilio Verify is not configured (never in production).
ALLOW_DEV_OTP=false
# Max OTP texts per hour across all numbers before the breaker refuses sends (default 60).
OTP_HOURLY_CAP=60
# Max OTP texts per phone number per day (default 8).
OTP_DAILY_PER_PHONE=8
# Store-review test phone (E.164) that skips the text; needs REVIEW_LOGIN_CODE too, else off.
REVIEW_LOGIN_PHONE=
# Six-digit code accepted for REVIEW_LOGIN_PHONE.
REVIEW_LOGIN_CODE=

# --- PGI (carrier) -----------------------------------------------------------------------
# PGI API key (live mode only).
PGI_API_KEY=test_pgi_api_key
# Shared secret the PGI webhook signature is checked against; webhook refuses calls when unset.
PGI_WEBHOOK_SECRET=test_pgi_webhook_secret
# PGI API base URL (live mode only).
PGI_BASE_URL=https://api.pgicover.com/api/v2/
# true = stubbed carrier responses, false = live PGI; unset = stub except in production.
USE_PGI_STUB=true

# --- BF-Server ---------------------------------------------------------------------------
# Base URL of BF-Server for document, message and referral calls.
BF_SERVER_URL=https://server.boreal.financial
# Shared token sent to BF-Server in service calls (must match BF-Server's value).
BACKEND_SERVICE_TOKEN=
# Token BF-Server presents on /internal/reply (x-backend-token); also a fallback for BACKEND_SERVICE_TOKEN.
BI_BACKEND_TOKEN=
# Bearer token required by POST /jobs/docs-reminder; unset -> that route answers 503.
JOB_AUTH_TOKEN=

# --- Public URLs -------------------------------------------------------------------------
# Public base URL of this server (Twilio signature checks, email asset and logo URLs).
BI_PUBLIC_BASE_URL=
# Older name for BI_PUBLIC_BASE_URL, used only as a fallback for email asset URLs.
PUBLIC_BASE_URL=
# Fallback public server URL for email logos when BI_PUBLIC_BASE_URL is unset.
PUBLIC_SERVER_URL=
# Public website used in applicant links (documents page, nudges, policy SMS).
BI_PUBLIC_URL=https://www.boreal.insure
# Client app base URL used in applicant message links.
BI_CLIENT_URL=https://client.boreal.insure
# Applicant portal base URL used in document-rejection messages.
APPLICANT_PORTAL_URL=https://borealinsurance.ca

# --- Email (SendGrid) --------------------------------------------------------------------
# SendGrid API key.
SENDGRID_API_KEY=
# Default From address for SendGrid email.
SENDGRID_FROM=hello@borealinsurance.ca
# BI-specific SendGrid key; overrides SENDGRID_API_KEY when set.
BI_SENDGRID_API_KEY=
# BI-specific From address; overrides SENDGRID_FROM when set.
BI_SENDGRID_FROM_EMAIL=
# SendGrid signed-event-webhook public key; unset -> the event webhook answers 503.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Minutes between scheduling a marketing send and its first email (default 2).
BI_SEND_HOLD_MINUTES=2
# Default sender mailbox for sequence emails (overrides the built-in default).
BI_SEQUENCE_DEFAULT_SENDER=

# --- SMS (Twilio) ------------------------------------------------------------------------
# Twilio account SID.
TWILIO_ACCOUNT_SID=test_twilio_sid
# Twilio auth token (also used to verify inbound webhook signatures).
TWILIO_AUTH_TOKEN=test_twilio_token
# Twilio sending number (E.164).
TWILIO_FROM=+10000000000
# Twilio Verify service SID used for OTP codes.
TWILIO_VERIFY_SERVICE_SID=test_verify_service_sid
# Staff phone (E.164) that gets chat alert texts.
ALERT_SMS_TO=+10000000000
# Staff phone (E.164) told when an applicant ignores 10 document reminders; unset -> no escalation.
BI_ESCALATION_PHONE=
# Comma-separated numbers texted when a scored application has co-guarantors.
MAYA_FALLBACK_SMS_NUMBERS=

# --- Storage and OCR (Azure) -------------------------------------------------------------
# Azure Blob Storage connection string for uploaded documents.
AZURE_STORAGE_CONNECTION_STRING=
# Blob container name for BI documents.
AZURE_STORAGE_CONTAINER_BI=
# Azure Document Intelligence endpoint (OCR).
AZURE_DOC_INTEL_ENDPOINT=
# Azure Document Intelligence key.
AZURE_DOC_INTEL_KEY=
# Older name for AZURE_DOC_INTEL_ENDPOINT (fallback).
AZURE_VISION_ENDPOINT=
# Older name for AZURE_DOC_INTEL_KEY (fallback).
AZURE_VISION_KEY=

# --- Push notifications ------------------------------------------------------------------
# Apple Developer team ID for APNs.
BI_APNS_TEAM_ID=
# APNs auth key ID.
BI_APNS_KEY_ID=
# APNs .p8 private key (newlines as \n).
BI_APNS_PRIVATE_KEY=
# iOS app bundle ID (APNs topic).
BI_APNS_BUNDLE_ID=
# "sandbox" for the APNs sandbox host; anything else uses production.
BI_APNS_ENVIRONMENT=
# Firebase service-account JSON for FCM (Android) pushes.
BI_FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Other integrations ------------------------------------------------------------------
# OpenAI API key (chat and document features).
OPENAI_API_KEY=
# Apollo.io API key (CRM enrichment and sequences).
APOLLO_API_KEY=
# Optional URL the chat route posts captured leads to.
CRM_WEBHOOK_URL=
# Lender API requests allowed per minute per caller (default 60).
RATE_LIMIT_LENDER_PER_MIN=60
